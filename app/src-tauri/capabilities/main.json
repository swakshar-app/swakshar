{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Setup, status, activity, settings and help. Cannot answer signature requests.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-is-visible",
    "allow-get-overview",
    "allow-list-tokens",
    "allow-open-status-page",
    "allow-set-paused",
    "allow-complete-onboarding",
    "allow-run-doctor",
    "allow-get-settings",
    "allow-save-settings",
    "allow-add-driver",
    "allow-remove-driver",
    "allow-install-trust",
    "allow-remove-trust",
    "allow-get-activity",
    "allow-clear-activity"
  ]
}
