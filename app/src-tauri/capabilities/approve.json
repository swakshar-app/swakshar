{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "approve-window",
  "description": "The approval window may only read, refresh and answer the waiting request.",
  "windows": [
    "approve"
  ],
  "permissions": [
    "core:event:default",
    "allow-get-pending-request",
    "allow-approve-request",
    "allow-cancel-request",
    "allow-refresh-request"
  ]
}
