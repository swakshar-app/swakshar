{
  "name": "swakshar-workspace",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:scripts && pnpm run build && pnpm run lines",
    "typecheck": "tsc -p scripts && pnpm --filter swakshar-ui run typecheck",
    "lint": "oxlint --deny-warnings",
    "build": "pnpm --filter swakshar-ui run build",
    "lines": "node scripts/check-line-limit.ts",
    "icons": "node scripts/generate-icons.ts",
    "tauri": "pnpm --filter swakshar-ui exec tauri",
    "test": "pnpm --filter swakshar-ui run test",
    "test:scripts": "node --test scripts/*.test.ts",
    "release-notes": "node scripts/release-notes.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "oxlint": "1.85.0",
    "typescript": "7.0.2"
  }
}
